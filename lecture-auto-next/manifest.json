{
  "manifest_version": 3,
  "name": "강의 자동 넘김 (Lecture Auto Next)",
  "version": "1.0.0",
  "description": "강의 영상이 끝나면 다음 회차로 자동 이동하고, 마지막 회차가 끝나면 1회차부터 다시 반복합니다.",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "강의 자동 넘김" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
